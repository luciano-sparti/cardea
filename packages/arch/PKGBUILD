# Maintainer: Luciano Sparti <https://github.com/Luciano-Sparti/cardea>
pkgname=cardea
pkgver=1.0.3
pkgrel=1
pkgdesc="A keyboard-driven, mouse-capable terminal file explorer with classical desktop file manager ergonomics"
arch=('x86_64' 'aarch64')
url="https://github.com/Luciano-Sparti/cardea"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Luciano-Sparti/cardea/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/cardea" "$pkgdir/usr/bin/cardea"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "assets/cardea.desktop" "$pkgdir/usr/share/applications/cardea.desktop"

    # Generate completions and man page from binary
    "$pkgdir/usr/bin/cardea" --generate-completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/cardea"
    "$pkgdir/usr/bin/cardea" --generate-completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_cardea"
    "$pkgdir/usr/bin/cardea" --generate-completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/cardea.fish"
    "$pkgdir/usr/bin/cardea" --generate-manpage | install -Dm644 /dev/stdin "$pkgdir/usr/share/man/man1/cardea.1"
}
