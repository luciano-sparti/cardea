# Maintainer: Luciano Sparti <https://github.com/Luciano-Sparti/fenestra>
pkgname=fenestra
pkgver=1.0.0
pkgrel=1
pkgdesc="A keyboard-driven, mouse-capable terminal file explorer with classical desktop file manager ergonomics"
arch=('x86_64' 'aarch64')
url="https://github.com/Luciano-Sparti/fenestra"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Luciano-Sparti/fenestra/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/fenestra" "$pkgdir/usr/bin/fenestra"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "assets/fenestra.desktop" "$pkgdir/usr/share/applications/fenestra.desktop"

    # Generate completions and man page from binary
    "$pkgdir/usr/bin/fenestra" --generate-completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/fenestra"
    "$pkgdir/usr/bin/fenestra" --generate-completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_fenestra"
    "$pkgdir/usr/bin/fenestra" --generate-completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/fenestra.fish"
    "$pkgdir/usr/bin/fenestra" --generate-manpage | install -Dm644 /dev/stdin "$pkgdir/usr/share/man/man1/fenestra.1"
}
