# Maintainer: Luciano Sparti <https://github.com/Luciano-Sparti/cardea>
pkgname=cardea-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="A keyboard-driven, mouse-capable terminal file explorer with classical desktop file manager ergonomics (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/Luciano-Sparti/cardea"
license=('MIT')
provides=('cardea')
conflicts=('cardea')
depends=('gcc-libs')

source_x86_64=("https://github.com/Luciano-Sparti/cardea/releases/download/v${pkgver}/cardea-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("https://github.com/Luciano-Sparti/cardea/releases/download/v${pkgver}/cardea-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    local src_dir="${srcdir}/cardea-v${pkgver}-${CARCH}-unknown-linux-gnu"
    if [ ! -d "$src_dir" ]; then
        src_dir="${srcdir}"
    fi

    install -Dm755 "${src_dir}/cardea" "${pkgdir}/usr/bin/cardea"
    install -Dm644 "${src_dir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 "${src_dir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 "${src_dir}/assets/cardea.desktop" "${pkgdir}/usr/share/applications/cardea.desktop"

    # Shell completions
    if [ -d "${src_dir}/completions" ]; then
        install -Dm644 "${src_dir}/completions/cardea.bash" "${pkgdir}/usr/share/bash-completion/completions/cardea"
        install -Dm644 "${src_dir}/completions/_cardea" "${pkgdir}/usr/share/zsh/site-functions/_cardea"
        install -Dm644 "${src_dir}/completions/cardea.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/cardea.fish"
    fi

    # Man page
    if [ -f "${src_dir}/man/cardea.1" ]; then
        install -Dm644 "${src_dir}/man/cardea.1" "${pkgdir}/usr/share/man/man1/cardea.1"
    fi
}
